# Copy to .env and adjust as needed.
# All values shown are the defaults used if the variable is unset.

# Directory containing source PDF documents to ingest
DOCS_PATH=./docs

# Persisted ChromaDB vector store location
CHROMA_PATH=./chroma_db

# HuggingFace embedding model (downloads ~130 MB on first use)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Ollama model name — must be pulled locally first: ollama pull llama3.2
LLM_MODEL=llama3.2

# ── Live data tools (optional) ──────────────────────────────────────────────
# Leave blank to disable the corresponding tool; the router will only expose
# tools whose URLs are configured.

# Prometheus HTTP API base URL (no trailing slash)
PROMETHEUS_URL=http://localhost:9090

# Jolokia HTTP endpoint on the AMQ Broker console port (no trailing slash)
JOLOKIA_URL=http://localhost:8161/console/jolokia
# Jolokia credentials — read from env, never hardcoded
JOLOKIA_USER=admin
JOLOKIA_PASSWORD=
